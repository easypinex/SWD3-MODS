<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SWD3 MOD Studio — 發佈與維護" Width="1380" Height="910" MinWidth="1080" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#243C48"/><SolidColorBrush x:Key="Muted" Color="#687E88"/><SolidColorBrush x:Key="Accent" Color="#147E73"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#D4DFE3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#12B5A1"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CFDFE2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="12,15"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="BorderBrush" Value="#CDDADF"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#9DCDC5"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,17,0,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="17,12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E5ECEF"/><Setter Property="BorderBrush" Value="#DCE5E8"/><Setter Property="Background" Value="White"/><Setter Property="MinRowHeight" Value="42"/><Setter Property="AlternatingRowBackground" Value="#F8FAFB"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5,8"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF3F4"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#163C43"><DockPanel Margin="22,27,22,22" LastChildFill="False">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  MOD STUDIO" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="軒轅劍參 · Steam 工作坊" Foreground="#91B4BB" Margin="0,10,0,28" FontSize="12"/>
    <Button x:Name="NavLibrary" Content="我的作品" Style="{StaticResource Nav}"/><Button x:Name="NavEditor" Content="發佈編輯" Style="{StaticResource Nav}"/><Button x:Name="NavOperations" Content="發佈紀錄" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="設定與診斷" Style="{StaticResource Nav}"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#35585E" Margin="0,16"/><TextBlock x:Name="AccountName" Text="尚未連線 Steam" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="AccountId" Text="請先登入 Steam 客戶端" Foreground="#91B4BB" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="DESKTOP  0.3.0" Foreground="#779FA7" FontSize="10" Margin="0,22,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,25,30,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="重新整理"/><Button x:Name="NewButton" Content="＋ 新建作品" Style="{StaticResource Primary}" Margin="0"/></StackPanel><StackPanel><TextBlock x:Name="PageTitle" Text="我的作品" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="找回已發佈的作品，讓每次更新都有跡可循。" Style="{StaticResource Small}"/></StackPanel></DockPanel>
   <Border Grid.Row="1" x:Name="NoticePanel" Background="#E4F0ED" CornerRadius="8" Padding="15,11" Margin="0,0,0,16"><TextBlock x:Name="NoticeText" Text="正在連接 Steam…"/></Border>
   <Grid Grid.Row="2">
    <Grid x:Name="LibraryPage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><TextBlock x:Name="WorkCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" Text="0 個作品" Foreground="{StaticResource Muted}"/><Grid><TextBox x:Name="SearchBox" ToolTip="搜尋標題或作品 ID" AutomationProperties.Name="搜尋作品"/><TextBlock Text="搜尋標題或作品 ID" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#84979F"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
     <TabControl Grid.Row="1" x:Name="LibraryTabs"><TabItem Header="Steam 作品"><Grid Margin="0,14,0,0"><ListBox x:Name="WorkList" AutomationProperties.Name="我的 Steam 作品"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="20,17" BorderBrush="#DCE5E8" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6B9998"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="LibraryEmpty" Text="連接 Steam 後，這裡會顯示你發佈過的作品。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid></TabItem>
      <TabItem Header="本機草稿"><ListBox x:Name="DraftList" Margin="0,14,0,0" AutomationProperties.Name="本機草稿"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#DCE5E8" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Small}"/><TextBlock Text="{Binding SavedAt}" Style="{StaticResource Small}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem></TabControl>
     <Border Grid.Row="2" Background="#EAF0F2" CornerRadius="8" Padding="16" Margin="0,14,0,18"><DockPanel><Button DockPanel.Dock="Right" x:Name="ImportItemButton" Content="開啟作品" Margin="12,0,0,0"/><Grid><TextBox x:Name="ImportIdBox" AutomationProperties.Name="工作坊網址或作品 ID" ToolTip="貼上 Steam 工作坊網址或作品 ID"/><TextBlock Text="貼上工作坊網址或作品 ID" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#84979F"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ImportIdBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
    </Grid>
    <Grid x:Name="EditorPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ReloadTextButton" Content="載入 Steam 文字"/><Button x:Name="SaveDraftButton" Content="保存草稿"/><Button x:Name="ExportDraftButton" Content="匯出"/><Button x:Name="ImportDraftButton" Content="匯入" Margin="0"/></StackPanel><TextBlock x:Name="EditIdentity" Text="新作品 · 尚未發佈" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel>
     <TabControl Grid.Row="1" x:Name="EditorTabs">
      <TabItem Header="編輯內容"><ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"><Grid x:Name="EditForm" Margin="0,16,12,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,22,0"><TextBlock Text="作品標題" Style="{StaticResource Label}" Margin="0,0,0,7"/><TextBox x:Name="TitleBox" AutomationProperties.Name="作品標題"/><TextBlock Text="內容說明" Style="{StaticResource Label}"/><TextBox x:Name="DescriptionBox" AutomationProperties.Name="內容說明" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="242" VerticalContentAlignment="Top"/>
        <TextBlock Text="本次更新說明" Style="{StaticResource Label}"/><TextBox x:Name="ChangeNoteBox" AutomationProperties.Name="本次更新說明" AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="發佈語言" Style="{StaticResource Label}"/><ComboBox x:Name="LanguageBox" SelectedIndex="0"><ComboBoxItem Content="繁體中文" Tag="tchinese"/><ComboBoxItem Content="簡體中文" Tag="schinese"/><ComboBoxItem Content="English" Tag="english"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="作品可見度" Style="{StaticResource Label}"/><ComboBox x:Name="VisibilityBox" SelectedIndex="1"><ComboBoxItem Content="維持目前設定" Tag="preserve"/><ComboBoxItem Content="私人" Tag="private"/><ComboBoxItem Content="公開" Tag="public"/><ComboBoxItem Content="僅限好友" Tag="friends"/><ComboBoxItem Content="不公開列出" Tag="unlisted"/></ComboBox></StackPanel></Grid>
        <TextBlock Text="中文標題與說明會同步到 Steam 的預設語言欄位，避免切換語言後仍看到舊版文字。" Style="{StaticResource Small}" Margin="0,12,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1"><Border Background="White" BorderBrush="#DAE4E7" BorderThickness="1" CornerRadius="10" Padding="17"><StackPanel><TextBlock Text="發佈封包" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="選擇已驗收的 .ssmod 成品" Style="{StaticResource Small}"/><TextBox x:Name="PackageBox" AutomationProperties.Name="封包路徑" Margin="0,15,0,9" TextWrapping="Wrap" MinHeight="42"/><Button x:Name="PickPackageButton" Content="選擇封包…" Margin="0"/><Button x:Name="RecoverPackageButton" Content="取回目前 Steam 封包" Margin="0,8,0,0"/><TextBlock x:Name="PackageSummary" Text="選取後將讀取實際版本與檔案大小。" Style="{StaticResource Small}" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Background="White" BorderBrush="#DAE4E7" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,16,0,0"><StackPanel><TextBlock Text="預覽圖片" FontSize="17" FontWeight="SemiBold"/><Border Background="#EFF4F5" CornerRadius="7" Height="122" Margin="0,12,0,10"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border><TextBox x:Name="PreviewBox" AutomationProperties.Name="預覽圖片路徑" TextWrapping="Wrap"/><Button x:Name="PickPreviewButton" Content="選擇圖片…" Margin="0,10,0,0"/><TextBlock Text="新作品必填，小於 1 MB。更新時留空即可沿用遠端圖片。" Style="{StaticResource Small}"/></StackPanel></Border>
       </StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="發佈前核對"><Grid Margin="0,16,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ReviewHeading" Text="完成編輯後，按下「準備並核對」查看本次變更。" Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold"/>
       <DataGrid x:Name="CheckGrid" Grid.Row="1" RowHeight="NaN" MinRowHeight="46"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="核對項目" Binding="{Binding Field}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="更新前" Binding="{Binding Before}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="本次內容" Binding="{Binding Expected}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Steam 查回" Binding="{Binding Actual}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="狀態" Binding="{Binding Status}" Width="85"/></DataGrid.Columns><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4,8"/></Style></DataGrid.Resources></DataGrid>
       <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="PublishButton" Content="確認發佈到 Steam" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="VerifyButton" Content="重新核對結果" IsEnabled="False"/><Button x:Name="ReportButton" Content="匯出核對報告" IsEnabled="False"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="遠端檔案"><Grid Margin="0,16,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button x:Name="FilesButton" Content="下載並查詢實際檔案" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock Text="從 Steam 下載後讀取版本並計算完整檔案雜湊。" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" x:Name="FileGrid"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="檔名" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding Version}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="大小" Binding="{Binding Size}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="SHA-256／狀態" Binding="{Binding Sha256}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="版本歷史"><Grid Margin="0,16,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button x:Name="HistoryButton" Content="查詢歷史" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock Text="這台電腦曾成功驗證的版本與更新說明。" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding Version}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="完成時間" Binding="{Binding Time}" Width="190"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="標題" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="更新說明" Binding="{Binding Note}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     </TabControl>
     <DockPanel Grid.Row="2" Margin="0,15,0,18"><Button x:Name="ReviewButton" Content="準備並核對 →" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="15,0,0,0"/><TextBlock x:Name="DraftStatus" Text="草稿會自動保存到本機。" Style="{StaticResource Small}" VerticalAlignment="Center"/></DockPanel>
    </Grid>
    <Grid x:Name="OperationsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="未完成的操作會保留原作品 ID。先核對結果，再決定下一步。" Margin="0,0,0,14"/>
     <DataGrid Grid.Row="1" x:Name="OperationGrid"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding Version}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="作品" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="狀態" Binding="{Binding Status}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="時間" Binding="{Binding Time}" Width="165"/></DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="2" Margin="0,16,0,18"><Button x:Name="ResumeButton" Content="開啟選取的操作" Style="{StaticResource Primary}"/><Button x:Name="RetryReviewButton" Content="重新審閱被拒絕的操作"/><Button x:Name="CloseOperationButton" Content="核對並結案未變更的操作"/><Button x:Name="ImportOperationButton" Content="匯入既有操作…"/><Button x:Name="OpenOperationFolder" Content="開啟資料夾"/></WrapPanel>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="10" BorderBrush="#DAE4E7" BorderThickness="1" Padding="22"><StackPanel><TextBlock Text="連線與資料" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SettingsInfo" Margin="0,12,0,14" TextWrapping="Wrap"/><WrapPanel><Button x:Name="HealthButton" Content="檢查 Steam 連線"/><Button x:Name="DataFolderButton" Content="開啟本機資料夾"/><Button x:Name="CopyLogButton" Content="複製診斷紀錄"/></WrapPanel></StackPanel></Border>
     <TextBlock Grid.Row="1" Text="本次執行紀錄" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,12"/><TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,18"/>
    </Grid>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#DCE5E8" BorderThickness="0,1,0,0" Padding="0,13,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ActivityText" Text="就緒" VerticalAlignment="Center"/><ProgressBar x:Name="Progress" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Foreground="#188F7F" Margin="15,0"/><Button Grid.Column="2" x:Name="StopButton" Content="停止等待" IsEnabled="False" Padding="12,6" Margin="0" ToolTip="停止本機等待，不代表 Steam 已取消上傳。"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
